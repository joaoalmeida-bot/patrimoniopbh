# Gere uma chave longa e aleatória para produção
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Cole a connection string do Supabase em modo Session pooler (porta 5432)
DATABASE_URL=postgresql://postgres:[SENHA]@[HOST]:5432/postgres
# Railway define PORT automaticamente; localmente 3000 é usado
PORT=3000
NODE_ENV=production
